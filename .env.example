# Telegram Hosting Bot Token (from @BotFather)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# List of Telegram user IDs with administrative privileges (comma-separated or JSON list)
ADMIN_IDS=123456789,987654321

# Root directory for per-bot sandboxed workspaces
WORKSPACE_ROOT=data/bots

# Resource limits and supervision defaults
MAX_BOTS_PER_USER=3
LOG_BUFFER_SIZE=1000
DEFAULT_RESTART_RETRIES=3
RESTART_DELAY_SECONDS=3.0
PROCESS_STOP_TIMEOUT=5.0
PIP_TIMEOUT_SECONDS=300

# SQLite Async Database URL
DATABASE_URL=sqlite+aiosqlite:///data/hosting.db
